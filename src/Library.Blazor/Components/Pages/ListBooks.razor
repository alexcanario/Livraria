@page "/ListBooks"
@attribute [StreamRendering]

<h3>Biblioteca</h3>

<p>
    <a href="/AddBook">Criar novo livro</a>
</p>

@if (Books is null)
{
    <img src="images/loading.gif" alt="" width="100" height="100" />
}
else
{
	<div class="row">
        @foreach (var book in Books)
        {
	        <BookCard @rendermode="InteractiveServer"  Book="@book"/>
        }
    </div>
}

@code {
    IEnumerable<Book>? Books { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        Books = await BookRepository.GetAllAsync();
    }
}