@page "/AddBook"

<PageTitle>Novo Livro</PageTitle>

<div class="row justify-content-center">
    <div class="col-6">
	    <BookForm EditMode="false" OnValidBookSubmit="Add"/>
    </div>
</div>

@code {
    private async Task Add(Book book)
    {
        await BookRepository.AddAsync(book);
        Navigation.NavigateTo("/ListBooks");
    }
}