<div class="col-md-3 mb-3">
	<div class="card custom-card">
		<img src="images/@Book?.BookCover" alt="images/semfoto.jpg" class="card-img-top custom-card-img">
		<div class="card-body">
			<h5 class="card-title">@Book?.Title</h5>
			<p class="card-text">@Book?.Author</p>
			<p class="card-text">@Book?.Publisher</p>
			<p class="card-text">Lançamento: @Book?.PublishedDate.ToShortDateString()</p>
			<div class="d-flex justify-content-between align-items-center mt-2">
				<a href="/editbook/@Book?.Id" class="btn btn-primary">Editar</a>
				<button class="btn btn-danger" @onclick="ConfirmDelete">Remover</button>
			</div>
		</div>
	</div>
</div>

<Dialogo Exibir="_showDialog" 
         OnCancel="CancelDelete" 
         OnDelete="DeleteBook">
		<p>Você tem certeza que deseja remover o livro @Book?.Title?</p>
</Dialogo>

@code {
	[Parameter] 
	public required Book Book { get; set; }

	private bool _showDialog;

	private void ConfirmDelete()
	{
		_showDialog = true;
	}

	private void CancelDelete()
	{
		_showDialog = false;
	}

	private async Task DeleteBook()
	{
		_showDialog = false;
		// Implementar a lógica de exclusão do livro aqui
		await BookRepository.Remove(Book.Id);
		Navigation.NavigateTo("/ListBooks");
	}
}