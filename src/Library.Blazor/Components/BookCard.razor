<div class="col-md-3 mb-3">
    <div class="card custom-card">
        <img src="images/@Book?.BookCover" alt="images/semfoto.jpg" class="card-img-top custom-card-img">
        <div class="card-body">
            <h5 class="card-title">@Book?.Title</h5>
	        <p class="card-text">@Book?.Author</p>
	        <p class="card-text">@Book?.Publisher</p>
            <p class="card-text">Lançamento: @Book?.PublishedDate.ToShortDateString()</p>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <a href="/EditBook/@Book?.Id" class="btn btn-primary">Editar</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] 
    public Book? Book { get; set; } = null!;
}
